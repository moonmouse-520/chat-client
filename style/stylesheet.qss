QDialog#LoginDialog, #RegisterDialog{
background-color:rgb(255,255,255);
}

#user_label, #pass_label{
    color:black;
}

#err_tip[state='normal']{
    color:green;
}

#err_tip[state='err']{
    color:red;
}

#pass_visible[state='unvisible']{
    border-image: url(:/res/unvisible.png);
}
#pass_visible[state='unvisible_hover']{
    border-image: url(:/res/unvisible_hover.png);
}
#pass_visible[state='visible']{
    border-image: url(:/res/visible.png);
}
#pass_visible[state='visible_hover']{
    border-image: url(:/res/visible_hover.png);
}

#confirm_visible[state='unvisible']{
    border-image: url(:/res/unvisible.png);
}
#confirm_visible[state='unvisible_hover']{
    border-image: url(:/res/unvisible_hover.png);
}
#confirm_visible[state='visible']{
    border-image: url(:/res/visible.png);
}
#confirm_visible[state='visible_hover']{
    border-image: url(:/res/visible_hover.png);
}
#forget_label[state='normal'],#forget_label[state='selected']{
    color:black;
}

#forget_label[state='hover'],#forget_label[state='selected_hover']{
    color:rgb(42,112,241);
}

#side_bar{
    background-color:rgb(46,46,46);
}

#add_btn[state='press']{
    border-image: url(:/res/add_friend_hover.png);
}

#search_wid {
    background-color: rgb(247,247,247);
}
#search_edit {
    border: 2px solid #f1f1f1;
}

/* 这里原来写的是 #chat_user_wid, 但那一行的 objectName 其实是 ChatUserWid,
   #id 选择器根本匹配不上(一条死规则)。删掉, 统一用下面的类选择器。 */

#chat_user_list {
    background-color: rgb(247,247,248);
    border: none;
}
/* 鼠标悬浮 -> 灰底; 选中的一行 -> 比悬浮再深一点, 一眼能看出"当前是谁" */
#chat_user_list::item:hover {
    background-color: rgb(235,235,236);
    border: none;
    outline: none;
}
#chat_user_list::item:selected {
    background-color: rgb(214,216,217);
    border: none;
    outline: none;
}
#chat_user_list:focus {
    border: none;
    outline: none;
}

/* 列表里的一行(ChatUserWid 是自定义类, QSS 里可以直接用类名当选择器)
   ★ 背景必须写透明: 行控件是用 setItemWidget() 贴在格子上的, 它要是自己刷一层
     不透明底色, 就会把列表的 ::item:hover / ::item:selected 高亮整个盖住 ——
     鼠标悬浮不变灰、选中看不出, 都是这个原因。透明之后底色交给列表画, 高亮就出来了。 */
ChatUserWid {
    background-color: transparent;
    border: none;
}
#user_chat_lb {
    color: rgb(153,153,153);
    font-size: 12px;
    font-family: "Microsoft YaHei";
}
#user_name_lb {
    color: rgb(0,0,0);
    font-size: 14px;
    font-weight: normal;
    font-family: "Microsoft YaHei";
}
#time_wid #time_lb {
    color: rgb(140,140,140);
    font-size: 12px;
    font-family: "Microsoft YaHei";
}

/* 细滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: rgb(173,170,169);
    min-height: 10px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: transparent;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

LoadingDlg {
    background: #f2eada;
}

/* ---- 侧边栏三个图标: ClickedLabel 靠 property("state") 换图 ---- */
#side_chat_lb[state='normal']         { border-image: url(:/res/chat_icon.png); }
#side_chat_lb[state='hover']          { border-image: url(:/res/chat_icon_hover.png); }
#side_chat_lb[state='press']          { border-image: url(:/res/chat_icon_press.png); }
#side_chat_lb[state='selected']       { border-image: url(:/res/chat_icon_select_hover.png); }
#side_chat_lb[state='selected_hover'] { border-image: url(:/res/chat_icon_select_hover.png); }

#side_contact_lb[state='normal']         { border-image: url(:/res/contact_list.png); }
#side_contact_lb[state='hover']          { border-image: url(:/res/contact_list_hover.png); }
#side_contact_lb[state='press']          { border-image: url(:/res/contact_list_press.png); }
#side_contact_lb[state='selected']       { border-image: url(:/res/contact_list_hover.png); }
#side_contact_lb[state='selected_hover'] { border-image: url(:/res/contact_list_hover.png); }

#side_apply_lb[state='normal']         { border-image: url(:/res/add_friend_normal.png); }
#side_apply_lb[state='hover']          { border-image: url(:/res/add_friend_hover.png); }
#side_apply_lb[state='press']          { border-image: url(:/res/add_friend_hover.png); }
#side_apply_lb[state='selected']       { border-image: url(:/res/add_friend_hover.png); }

/* ---- 表情 / 文件图标 ---- */
#emo_lb  { border-image: url(:/res/smile.png); }
#file_lb { border-image: url(:/res/filedir.png); }
#emo_lb[state='hover']  { border-image: url(:/res/smile_hover.png); }
#emo_lb[state='press']  { border-image: url(:/res/smile_press.png); }
#file_lb[state='hover'] { border-image: url(:/res/filedir_hover.png); }
#file_lb[state='press'] { border-image: url(:/res/filedir_press.png); }

/* ---- ChatPage 自己的背景(paintEvent + 这条, 才看得出区别) ---- */
#chat_page, ChatPage { background: #ffffff; }
#tool_wid { background: #ffffff; border-bottom: 0.5px solid #ececec; }
#chat_edit { background: #ffffff; border: none; font-family: "Microsoft YaHei"; font-size: 18px; padding: 5px; }
#title_lb { font-family: "Microsoft YaHei"; font-size: 18px; }

#chat_area { border: none; background: transparent; }
#chat_bg   { background: #f5f5f5; }

#chat_user_name { color: rgb(153,153,153); font-size: 14px; font-family: "Microsoft YaHei"; }

#side_chat_lb[state='selected_pressed']    { border-image: url(:/res/chat_icon_press.png); }
#side_contact_lb[state='selected_pressed'] { border-image: url(:/res/contact_list_press.png); }
#side_apply_lb[state='selected_hover']     { border-image: url(:/res/add_friend_hover.png); }
#side_apply_lb[state='selected_pressed']   { border-image: url(:/res/add_friend_hover.png); }

/* 搜索列表里"提示行"的底色(灰度区分, 让它不像可点项) */
#invalid_item {
    background-color: #eaeaea;
    border: none;
}

/* 左边加号图标 / 右边小箭头 */
#add_tip   { border-image: url(:/res/addtip.png); }
#right_tip { border-image: url(:/res/right_tip.png); }

/* 中间那行文字 */
#message_tip {
    font-family: "Microsoft YaHei";
    font-size: 12pt;
}

#FindSuccessDlg, #FindFailDlg {
    background: #f7f7f8;
    border: 2px solid #f1f1f1;
}
#name_lb  { font-family: "Microsoft YaHei"; font-size: 16px; }
#fail_tip { font-family: "Microsoft YaHei"; font-size: 16px; }
#fail_tip2{ color: rgb(140,140,140); font-size: 13px; }

#ApplyFriendPage, #friend_apply_page { background: #f7f7f8; }
#friend_apply_lb { font-family: "Microsoft YaHei"; font-size: 16px; }
#apply_friend_list { background: #f7f7f8; border: none; }
#apply_friend_list::item:hover    { background: rgb(206,207,208); border: none; }
#apply_friend_list::item:selected { background: #d3d7d4;    border: none; }
#already_add_lb  { color: rgb(153,153,153); font-size: 13px; }
/* 申请行同理: 行控件透明, 悬浮高亮由 #apply_friend_list::item:hover 画 */
#ApplyFriendItem { background-color: transparent; }

#AuthenFriend { background: #f7f7f8; border: 2px solid #f1f1f1; }
#tip_lb { font-family: "Microsoft YaHei"; font-size: 15px; }

#red_point { border-radius: 4px; background: red; min-width: 8px; min-height: 8px; }
/* ============================================================
   联系人列表 + 好友资料页(我们自己补的)
   ============================================================ */
#con_user_list {
    background-color: #f7f7f8;
    border: none;
}
#con_user_list::item:hover    { background-color: rgb(206,207,208); border: none; outline: none; }
#con_user_list::item:selected { background-color: #d3d7d4;          border: none; outline: none; }
#con_user_list:focus { border: none; outline: none; }

#ConUserItem { background: transparent; }
#ConUserItem #name_lb {
    font-family: "Microsoft YaHei";
    font-size: 14px;
    color: #161616;
}

/* ---- 好友资料页 ---- */
#FriendInfoPage, #friend_info_page { background: #f7f7f8; }
#friend_info_page #name_lb {
    font-family: "Microsoft YaHei";
    font-size: 20px;
    color: #161616;
}
#friend_info_page #nick_lb { font-family: "Microsoft YaHei"; font-size: 13px; color: rgb(140,140,140); }
#friend_info_page #desc_tip, #friend_info_page #bak_tip, #friend_info_page #sex_tip {
    font-family: "Microsoft YaHei"; font-size: 13px; color: rgb(153,153,153);
}
#friend_info_page #desc_lb, #friend_info_page #bak_lb, #friend_info_page #sex_lb {
    font-family: "Microsoft YaHei"; font-size: 14px; color: #161616;
}

/* 资料页"发消息"按钮: 没有现成切图, 直接用底色做三态 */
#msg_chat[state='normal'] { background: #07c160; color: white; border: none; border-radius: 4px; font-family: "Microsoft YaHei"; font-size: 14px; }
#msg_chat[state='hover']  { background: #06ad56; color: white; border: none; border-radius: 4px; font-family: "Microsoft YaHei"; font-size: 14px; }
#msg_chat[state='press']  { background: #059748; color: white; border: none; border-radius: 4px; font-family: "Microsoft YaHei"; font-size: 14px; }


#chat_user_list::item:hover    { background-color: rgb(206,207,208); }
#chat_user_list::item:selected { background-color: #d3d7d4; }

/* ============================================================
   加好友 / 认证弹窗的样式(从教程原版挑过来, 已把 × 按钮的
   [#close_lb state='select_*'] 修正成 selected_*, 原版这里其实匹配不上)
   ★ 两个弹窗共用同一套: #apply_wid 里所有子控件的 objectName 必须保持同名
   ============================================================ */
#ApplyFriend{
    border: 2px solid #f1f1f1;
    font-size: 14px;
    background: #f7f7f8;
}

#scrollArea{
    background: #f7f7f8;
    border: none;
}

#scrollcontent{
     background: #f7f7f8;
}

#scrollcontent #apply_lb{
    font-family: "Microsoft YaHei";
    font-size: 16px;
    font-weight: normal;
}

#apply_wid QLabel{
    color:rgb(140,140,140);
    font-size: 14px;
    font-family: "Microsoft YaHei";
    height: 25px;
}

#apply_wid #name_ed, #apply_wid #back_ed{
    border: 1px solid #f7f7f8;
    font-size: 14px;
    font-family: "Microsoft YaHei";
}

#apply_wid #lb_ed {
       border: none;
       font-size: 14px;
       font-family: "Microsoft YaHei";
}

#apply_wid #more_lb{
    border-image: url(:/res/arowdown.png);
}

#apply_wid #tipslb[state='normal'] {
    padding: 2px;
    background: #e1e1e1;
    color: #1e1e1e;
    border-radius: 10px;
}

#apply_wid #tipslb[state='hover'] {
    padding: 2px;
    background: #e1e1e1;
    color: #1e1e1e;
    border-radius: 10px;
}

#apply_wid #tipslb[state='pressed'] {
    padding: 2px;
    background: #e1e1e1;
    color: #48bf56;
    border-radius: 10px;
}

#apply_wid #tipslb[state='selected_normal'] {
    padding: 2px;
    background: #e1e1e1;
    color: #48bf56;
    border-radius: 10px;
}

#apply_wid #tipslb[state='selected_hover'] {
    padding: 2px;
    background: #e1e1e1;
    color: #48bf56;
    border-radius: 10px;
}

#apply_wid #tipslb[state='selected_pressed'] {
    padding: 2px;
    background: #e1e1e1;
    color: #1e1e1e;
    border-radius: 10px;
}

#input_tip_wid {
    background: #d3eaf8;
}

#apply_wid #FriendLabel {
    background: #daf6e7;
    color: #48bf56;
    border-radius: 10px;
}

#apply_wid #tip_lb {
    padding-left: 2px;
    color:rgb(153,153,153);
    font-size: 14px;
    font-family: "Microsoft YaHei";
}

#gridWidget {
   background: #fdfdfd;
}

#close_lb[state='normal'] {
    border-image: url(:/res/tipclose.png);
}

#close_lb[state='hover'] {
    border-image: url(:/res/tipclose.png);
}

#close_lb[state='pressed'] {
    border-image: url(:/res/tipclose.png);
}

#close_lb[state='selected_normal'] {
    border-image: url(:/res/tipclose.png);
}

#close_lb[state='selected_hover'] {
    border-image: url(:/res/tipclose.png);
}

#close_lb[state='selected_pressed'] {
    border-image: url(:/res/tipclose.png);
}

#apply_sure_wid #sure_btn[state='normal']  {
    background: #f0f0f0;
    color: #2cb46e;
